{
  "schema_version": "vv-agent.prompt-bundle.v2",
  "section_contract": {
    "required_fields": [
      "id",
      "text",
      "stable"
    ],
    "optional_fields": [
      "source",
      "cache_hint",
      "metadata"
    ],
    "unknown_fields": "reject",
    "id": "non_empty_unique_string",
    "text": "non_empty_after_canonical_ASCII_whitespace_trim",
    "text_normalization": "strip only U+0009 U+000A U+000B U+000C U+000D and U+0020 from both ends before validation and serialization",
    "source": "omitted_or_non_empty_string",
    "cache_hint": "omitted_or_non_empty_string",
    "metadata": "omitted_or_json_object",
    "order": "array_order_is_model_visible_order",
    "stable_semantics": "resolved_text_is_eligible_for_a_stable_prefix; it_never_requests_reexecution_per_cycle",
    "empty_sections": "omit_before_bundle"
  },
  "bundle_contract": {
    "required_fields": [
      "sections",
      "stable_hash"
    ],
    "unknown_fields": "reject",
    "sections": "non_empty_array_of_closed_prompt_sections",
    "flat_prompt": "join section.text in array order with exactly two LF characters",
    "stable_hash": {
      "algorithm": "SHA-256",
      "input": "RFC 8785 UTF-8 bytes of ordered stable section objects after absent optional fields are omitted",
      "encoding": "lowercase_hex",
      "provider_directive": false
    },
    "derived_fields_not_serialized": [
      "prompt",
      "sources",
      "total_chars"
    ]
  },
  "compiler_contract": {
    "agent_instruction_values": [
      "string",
      "prompt_bundle"
    ],
    "string_instruction_section": {
      "id": "agent_instructions",
      "stable": true,
      "source": "agent.instructions"
    },
    "instruction_bundle_order": "preserve_exactly",
    "compiler_owned_sections_after_instruction_bundle": [
      "configured_sub_agents"
    ],
    "provider_fragment_order": "ascending_priority_then_stable_before_volatile_then_utf16_id_then_provider_emission_order",
    "forbidden": [
      "flatten_then_rewrap_as_agent_instructions",
      "system_prompt_sections_metadata_transport",
      "per_cycle_instruction_or_context_producer_execution"
    ]
  },
  "provider_projection": {
    "common": {
      "system_text": "flat_prompt",
      "preserve_section_order": true,
      "metadata_is_not_provider_cache_protocol": true,
      "local_fields_never_emitted": [
        "id",
        "stable",
        "source",
        "cache_hint",
        "metadata",
        "stable_hash"
      ]
    },
    "explicit_section_cache": {
      "capability_id": "explicit_system_section_cache.v1",
      "system_representation": "ordered_text_blocks",
      "separator_rule": "append exactly two LF characters to every block except the final block",
      "breakpoint_rule": "one breakpoint at the end of the longest leading stable run; no breakpoint when the first section is volatile",
      "provider_cache_control": {
        "type": "ephemeral"
      },
      "cache_hint_behavior": "ignored_by_this_capability"
    },
    "flatten_only": {
      "system_representation": "one_flattened_system_message",
      "cache_control_fields": "absent"
    },
    "projection_cases": [
      {
        "name": "flatten_en_US_full",
        "scenario_ref": "en-US-full",
        "mode": "flatten_only",
        "expected": {
          "system_message": {
            "role": "system",
            "content": "<Agent Definition>\nYou are a careful coding agent.\n</Agent Definition>\n\n<Environment>\nYou are running in a <OS> workspace environment and can use tools to inspect and modify files.\n</Environment>\n\n<Tools>\nAsk the user only for a required decision that cannot be resolved from context or available tools.\n\nPrefer specialized workspace tools for direct file operations; use bash when they are insufficient.\n\nFor multi-step work, keep the TODO state current with at most one item in progress.\n\nConfigured sub-agents:\n- agent_id=`researcher`: Finds source evidence.\n- agent_id=`writer`: Writes the final report.\n\nAvailable skills metadata (Agent Skills format):\n<available_skills>\n<skill>\n<name>\nreview-code\n</name>\n<description>\nReview code against the requested contract.\n</description>\n<location>\nskills/review-code/SKILL.md\n</location>\n</skill>\n</available_skills>\n\nUse task_finish for an explicit final result. Natural completion is allowed when the configured no-tool policy permits it.\n</Tools>\n\n<Session Memory>\n- Keep source evidence.\n</Session Memory>\n\n<Current Time>\nActual task start time (UTC):\n2026-07-10T08:30:00Z\n</Current Time>"
          },
          "cache_control_fields": []
        }
      },
      {
        "name": "section_cache_en_US_full",
        "scenario_ref": "en-US-full",
        "mode": "explicit_section_cache",
        "expected": {
          "system_blocks": [
            {
              "type": "text",
              "text": "<Agent Definition>\nYou are a careful coding agent.\n</Agent Definition>\n\n"
            },
            {
              "type": "text",
              "text": "<Environment>\nYou are running in a <OS> workspace environment and can use tools to inspect and modify files.\n</Environment>\n\n"
            },
            {
              "type": "text",
              "text": "<Tools>\nAsk the user only for a required decision that cannot be resolved from context or available tools.\n\nPrefer specialized workspace tools for direct file operations; use bash when they are insufficient.\n\nFor multi-step work, keep the TODO state current with at most one item in progress.\n\nConfigured sub-agents:\n- agent_id=`researcher`: Finds source evidence.\n- agent_id=`writer`: Writes the final report.\n\nAvailable skills metadata (Agent Skills format):\n<available_skills>\n<skill>\n<name>\nreview-code\n</name>\n<description>\nReview code against the requested contract.\n</description>\n<location>\nskills/review-code/SKILL.md\n</location>\n</skill>\n</available_skills>\n\nUse task_finish for an explicit final result. Natural completion is allowed when the configured no-tool policy permits it.\n</Tools>\n\n",
              "cache_control": {
                "type": "ephemeral"
              }
            },
            {
              "type": "text",
              "text": "<Session Memory>\n- Keep source evidence.\n</Session Memory>\n\n"
            },
            {
              "type": "text",
              "text": "<Current Time>\nActual task start time (UTC):\n2026-07-10T08:30:00Z\n</Current Time>"
            }
          ],
          "cache_boundary_block_index": 2
        }
      },
      {
        "name": "section_cache_no_leading_stable_prefix",
        "scenario_ref": "all-volatile",
        "mode": "explicit_section_cache",
        "expected": {
          "system_blocks": [
            {
              "type": "text",
              "text": "request_id=fixture-volatile"
            }
          ],
          "cache_boundary_block_index": null
        }
      }
    ]
  },
  "session_memory_gate": {
    "control": "session_memory_enabled",
    "default": false,
    "enabled_value": true,
    "disabled_or_omitted_context_behavior": "ignore_without_rendering_or_storage_access",
    "session_memory_section_requires_enabled_true": true,
    "context_presence_does_not_enable_session_memory": true,
    "probe_cases": [
      {
        "name": "explicit_false_ignores_nonempty_context",
        "base_scenario": "en-US-minimal",
        "expected_session_memory_section_count": 0,
        "expected_prompt_equals_base_output": true,
        "expected_storage_reads": 0,
        "expected_storage_writes": 0
      },
      {
        "name": "omitted_control_ignores_nonempty_context",
        "base_scenario": "en-US-minimal",
        "input_mutation": {
          "remove": "session_memory_enabled"
        },
        "expected_session_memory_section_count": 0,
        "expected_prompt_equals_base_output": true,
        "expected_storage_reads": 0,
        "expected_storage_writes": 0
      }
    ]
  },
  "run_scope": {
    "instruction_and_context_producers": "resolve_once_when_new_run_is_compiled",
    "current_time": "resolve_once_per_new_run",
    "same_run_cycles": "reuse_frozen_bundle",
    "new_run": "may_resolve_a_different_time",
    "checkpoint_resume": "restore_frozen_bundle_without_producer_or_clock_access",
    "run_definition": {
      "field": "prompt_bundle",
      "schema_version": "vv-agent.run-definition.v3",
      "forbidden_fields": [
        "compiled_prompt",
        "system_prompt_sections"
      ]
    },
    "conformance_cases": [
      {
        "name": "three_cycles_reuse_one_resolution",
        "new_run_compile_count": 1,
        "cycle_count": 3,
        "expected_instruction_producer_calls": 1,
        "expected_context_provider_calls": 1,
        "expected_clock_reads": 1,
        "expected_distinct_bundle_values": 1
      },
      {
        "name": "two_new_runs_resolve_independently",
        "new_run_compile_count": 2,
        "expected_instruction_producer_calls": 2,
        "expected_context_provider_calls": 2,
        "expected_clock_reads": 2,
        "time_values_may_differ": true
      },
      {
        "name": "checkpoint_resume_uses_frozen_bundle",
        "resume_count": 1,
        "expected_resume_instruction_producer_calls": 0,
        "expected_resume_context_provider_calls": 0,
        "expected_resume_clock_reads": 0,
        "expected_bundle_relation": "byte_equal"
      }
    ]
  },
  "normalization_rules": {
    "computer_os": "Replace the host OS label in rendered environment text with <OS> and recompute the stable hash."
  },

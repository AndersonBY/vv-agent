{
  "bundle_contract": {
    "derived_fields_not_serialized": [
      "prompt",
      "sources",
      "total_chars"
    ],
    "flat_prompt": "join section.text in array order with exactly two LF characters",
    "required_fields": [
      "sections",
      "stable_hash"
    ],
    "sections": "non_empty_array_of_closed_prompt_sections",
    "stable_hash": {
      "algorithm": "SHA-256",
      "encoding": "lowercase_hex",
      "input": "RFC 8785 UTF-8 bytes of ordered stable section objects after absent optional fields are omitted",
      "provider_directive": false
    },
    "unknown_fields": "reject"
  },
  "compiler_contract": {
    "agent_instruction_values": [
      "string",
      "prompt_bundle"
    ],
    "compiler_owned_sections_after_instruction_bundle": [
      "configured_sub_agents"
    ],
    "forbidden": [
      "flatten_then_rewrap_as_agent_instructions",
      "system_prompt_sections_metadata_transport",
      "per_cycle_instruction_or_context_producer_execution"
    ],
    "instruction_bundle_order": "preserve_exactly",
    "provider_fragment_order": "ascending_priority_then_stable_before_volatile_then_utf16_id_then_provider_emission_order",
    "string_instruction_section": {
      "id": "agent_instructions",
      "source": "agent.instructions",
      "stable": true
    }
  },

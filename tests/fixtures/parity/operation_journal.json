  "transition_rules": {
    "allowed": [
      [
        "planned",
        "failed"
      ],
      [
        "planned",
        "started"
      ],
      [
        "started",
        "succeeded"
      ],
      [
        "started",
        "failed"
      ],
      [
        "started",
        "ambiguous"
      ],
      [
        "started",
        "deferred"
      ],
      [
        "ambiguous",
        "planned"
      ],
      [
        "ambiguous",
        "succeeded"
      ],
      [
        "ambiguous",
        "failed"
      ],
      [
        "ambiguous",
        "deferred"
      ],
      [
        "deferred",
        "succeeded"
      ],
      [
        "deferred",
        "failed"
      ]
    ],
    "terminal_receipts": [
      "succeeded",
      "failed"
    ],
    "cycle_commit_clears_committed_journals": true,
    "progress_write_preserves_active_claim": true,
    "request_digest_mismatch": "checkpoint_journal_integrity_mismatch_before_claim_without_state_transition",
    "retry_attempt": "previous_plus_one",
    "same_logical_retry_reuses_operation_id_and_idempotency_key": true
  },
  "deferred_rules": {
    "state_requires_handle": true,
    "state_has_no_result_or_error": true,
    "admission_transition_is_atomic_with_claim_release": true,
    "resolution_operation": "resolve_deferred",
    "resolution_requires_definitive_tool_result": true,
    "same_replay_is_idempotent": true,
    "receipt_index": {
      "namespace": "deferred_resolution_receipts",
      "checkpoint_field": null,
      "independent": true,
      "required": true,
      "bounded": false,
      "arbitrary_cardinality": true,
      "retained_across_cycle_and_terminal": true,
      "cleanup_with_checkpoint": true,
      "same_store_atomicity": true,
      "entry_fields": [
        "handle_key",
        "handle",
        "result",
        "result_digest",
        "event_id",
        "event_payload_digest",
        "receipt_status"
      ],
      "success_transition": [
        "deferred",
        "succeeded"
      ],
      "error_transition": [
        "deferred",
        "failed"
      ]
    },
    "receipt_lookup_precedes_active_journal": true,
    "early_callback_rules": {
      "matching_started": {
        "decision_kind": "not_admitted",
        "retryable_error": "deferred_resolution_not_admitted",
        "retryable": true,
        "writes": []
      },
      "matching_ambiguous": {
        "decision_kind": "reconciliation_required",
        "writes": []
      },
      "host_retains_result_until_admission": true
    },
    "internal_revision_cas_retry": true,
    "caller_does_not_pass_revision_argument": true,
    "conflicting_replay_error": "deferred_resolution_conflict",
    "stale_resolution_error": "deferred_resolution_stale",
    "claimed_checkpoint_error": "deferred_checkpoint_claimed",
    "stale_only_when": [
      "no_retained_receipt",
      "no_active_matching_journal"
    ],
    "last_resolution_decisions": {
      "barrier_empty": "applied_ready",
      "barrier_nonempty": "applied_waiting",
      "ready_dispatch": "reuse_retained_previous_envelope_with_existing_driver_advance_or_running_reconciler_dispatch",
      "polling": false
    }
  },
  "outcome_classification": {
    "failed_requires_definitive_external_outcome": true,
    "pre_dispatch_local_failure": "planned_to_failed",
    "explicit_provider_or_tool_rejection": "started_to_failed",
    "timeout_after_started": "ambiguous_unless_the_adapter_proves_a_definitive_outcome",
    "cancellation_after_started": "ambiguous_unless_the_adapter_proves_a_definitive_outcome",
    "connection_loss_after_started": "ambiguous",
    "non_cooperative_blocking_tool_timeout": "ambiguous_even_if_the_waiting_runtime_returns",
    "framework_must_not_assume_a_timed_out_thread_or_process_stopped_side_effects": true
  },
  "pre_start_rules": {
    "approval_pending_may_remain_planned": true,
    "approval_grant_must_be_durable_before_started": true,
    "approval_denial_or_timeout_writes_started": false,
    "tool_policy_denial_writes_started": false,
    "before_tool_hook_short_circuit_writes_started": false,
    "approval_resume_uses_source_tool_call_id_request_digest_and_idempotency_key": true,
    "approval_resume_operation_id_is_stable_within_the_distinct_resume_run": true,
    "session_memory_compaction_and_ptl_requests_are_journaled_model_operations": true,
    "model_operation_and_dispatch_attempt_id_are_durable": true,
    "started_means_provider_may_or_may_not_have_received_request": true,
    "model_started_state_and_started_event_are_one_progress_cas": true,
    "terminal_model_state_ledger_budget_and_outbox_are_one_progress_cas": true,
    "ambiguous_recovery_ledger_budget_and_failed_event_are_one_progress_cas": true,
    "pre_dispatch_model_failure_adds_no_model_call_record": true,
    "receipt_replay_does_not_append_usage_or_budget": true
  },
  "model_call_accounting": {
    "identity_contract": {
      "fields": [
        "call_id",
        "operation_id",
        "attempt",
        "operation",
        "cycle_index",
        "backend",
        "model"
      ],
      "journal_operation_field": "model_operation",
      "other_record_operation_field": "operation",
      "backend_and_model_source": "actual_effective_dispatch",
      "root_run_definition_model_is_not_a_fallback": true,
      "journal_started_event_terminal_event_and_ledger_must_match": true,
      "missing_or_mismatch_error": "checkpoint_status_invalid"
    },

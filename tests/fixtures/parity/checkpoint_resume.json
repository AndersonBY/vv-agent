{
  "contract": "checkpoint_resume",
  "version": 8,
  "checkpoint_schema": "vv-agent.checkpoint.v8",
  "run_definition_schema": "vv-agent.run-definition.v5",
  "checkpoint_wire": {
    "required_fields": [
      "active_host_interaction",
      "suspended_origin"
    ],
    "active_host_interaction": "complete closed vv-agent.host-interaction-request.v1 object including prompt or null; restored before wake after crash",
    "suspended_origin": "closed {status, active_host_interaction} object or null",
    "old_discriminator": "vv-agent.checkpoint.v7",
    "old_discriminator_error": "checkpoint_schema_unsupported",
    "forward_only_reader": true
  },
  "public_entrypoints": {
    "run": "Runner.run with RunConfig.checkpoint_config",
    "start": "Runner.start with RunConfig.checkpoint_config",
    "durable_resume": "repeat Runner.run with the same Agent, root input, and stable checkpoint key",
    "approval_resume_is_separate": true,
    "new_input_on_durable_resume": false
  },
  "checkpoint_states": [
    "pending",
    "running",
    "host_interaction",
    "suspended",
    "deferred",
    "reconciliation_required",
    "wait_user",
    "completed",
    "failed",
    "max_cycles"
  ],
  "deferred_pending_semantics": "no cycle commit and no response result were returned by this delivery attempt",
  "controller_command_semantics": {
    "request_fixture": "controller_command.json",
    "host_interaction_and_suspended_are_non_terminal": true,
    "host_interaction_identity_is_persisted": true,
    "suspended_origin_is_persisted": true,
    "producer_claim_release_and_interaction_cas_are_one_transaction": true,
    "same_logical_cycle_recovery": true,
    "cycle_index_is_last_committed": true,
    "claimed_cycle_is_cycle_index_plus_one": true,
    "active_host_interaction_and_suspended_origin_reload_before_wake": true,
    "active_host_interaction_persists_complete_request": true,
    "resolved_response_persists_complete_message_before_wake": true,
    "response_consumed_exactly_once_with_marker": true,
    "response_revision_semantics": {
      "numbers_are_examples": true,
      "admission_revision": "expected_revision + 1",
      "example_expected_revision": 8,
      "example_admission_revision": 9,
      "consume_revision": "admission_revision + 1",
      "example_consume_revision": 10
    },
    "response_recovery_operation": "claim_and_consume_host_interaction_response",
    "response_recovery_claim_mode": "recovery",
    "response_recovery_resume_attempt": {
      "wire_value": "authoritative value before the combined recovery claim",
      "successful_claim": "increment exactly once; consumed event and next envelope use the incremented value",
      "example_before": 2,
      "example_after": 3,
      "failed_or_stale": "preserve 2",
      "replay": "retain 3 without another increment"
    },
    "response_recovery_locks_checkpoint_and_record": true,
    "response_recovery_retains_checkpoint_execution_claim": true,
    "response_recovery_releases_record_claim": true,
    "response_record_only_claim_forbidden": true,
    "response_crash_before_commit_rolls_back": true,
    "host_interaction_producer_notification_does_not_wake_worker": true,
    "host_interaction_notification_wait_reason": "host_interaction",
    "host_interaction_notification_delivery": "at_least_once_with_observer_deduplication",
    "host_interaction_notification_ambiguity": {
      "operation": "reconcile_host_interaction_notification(notification_id, payload_digest, outcome)",
      "outcomes": ["delivered", "retry", "abort"],
      "reaper": "retry pending or expired claimed; route ambiguous to explicit reconciliation; retain aborted as terminal audit",
      "blind_retry_ambiguous": false
    },
    "suspended_state_change_notification": "separate_run_state_changed_event; host interaction notification immutable",
    "suspended_running_origin_resume_wakes": true,
    "suspended_host_origin_resume_without_response_waits": true,
    "suspended_host_origin_resume_with_response_wakes": true,
    "ask_user_wait_user_remains_terminal": true,
    "deferred_resolution_is_independent": true,
    "terminal_successor_is_independent": true
  },

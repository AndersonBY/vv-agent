    "started": {
      "trigger_values": [
        "micro_threshold",
        "full_threshold",
        "prompt_too_long"
      ],
      "producer_fields": [
        "trigger",
        "configured_threshold",
        "effective_threshold",
        "microcompact_threshold",
        "microcompact_target",
        "candidate_count",
        "estimated_reclaimable_tokens",

        "model_max_output_tokens",
        "reserved_output_tokens",
        "reserved_output_source",
        "autocompact_buffer_tokens"
      ],
      "candidate_count_semantics": "number_of_oldest_first_candidates_selected_by_the_single_plan",
      "estimated_reclaimable_tokens_semantics": "estimated_prompt_token_reduction_if_every_selected_archive_succeeds"
    },
    "completed": {
      "mode_values": [
        "none",
        "micro",
        "structural",
        "summary",
        "emergency"
      ],
      "producer_fields": [
        "mode",
        "changed",
        "archived_count",
        "reclaimed_tokens",
        "artifact_failure_count"
      ],
      "archived_count_semantics": "selected_results_successfully_persisted_and_replaced",
      "reclaimed_tokens_semantics": "actual_prompt_token_reduction_after_successful_replacements",
      "artifact_failure_count_semantics": "selected_results_left_inline_because_archive_persistence_failed",
      "changed_is_content_aware": true,
      "mode_is_strongest_applied_stage": true,
      "mode_semantics": {
        "none": "no_change",
        "micro": "only_archive_backed_result_replacement",
        "structural": "information_preserving_cleanup_or_warning_only",
        "summary": "accepted_prefix_summary_and_raw_tail",
        "emergency": "accepted_resummary_with_smaller_raw_tail_target"
      }
    },
    "microcompact_planning": {
      "single_plan_and_apply_pass_per_cycle": true,
      "candidate_required_for_micro_threshold_trigger": true,
      "micro_threshold_without_candidate_event_count": 0,
      "full_or_prompt_too_long_trigger_may_start_without_micro_candidate": true,
      "candidate_order": "oldest_first",
      "stop_condition": "actual_post_replacement_usage_at_or_below_microcompact_target_or_candidates_exhausted",
      "planned_estimates_do_not_satisfy_target": true,
      "reclaimed_tokens_per_candidate": "actual_original_message_tokens_minus_actual_replacement_message_tokens",
      "recalculate_actual_usage_after_each_successful_replacement": true,
      "archive_before_replace": true,
      "archive_failure_preserves_original": true,
      "existing_artifact_requires_utf8_size_and_sha256_validation": true,
      "existing_artifact_validation_failure_preserves_original": true,
      "archive_failure_does_not_stop_later_candidates": true
    },
    "simultaneous_warning_and_microcompact": {
      "order": [
        "microcompact_eligible_old_tool_results",
        "recalculate_effective_length",
        "append_memory_warning_only_if_post_microcompact_length_remains_eligible"
      ],
      "warning_uses_post_microcompact_length": true,
      "warning_must_not_prevent_eligible_microcompact": true
    },
    "provider_and_journal_share_event_identity": [
      "event_id",
      "created_at"
    ],
    "missing_or_unknown_fields_are_rejected": true,

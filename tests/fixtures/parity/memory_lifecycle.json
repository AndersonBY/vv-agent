{
  "version": "memory_lifecycle",
  "summary_route": {
    "backend": "memory-backend",
    "model": "memory-model",
    "request_model": "memory-model",
    "resolution_count": 1
  },
  "session_extraction_route": {
    "backend": "session-memory-backend",
    "model": "session-memory-model",
    "request_model": "session-memory-model",
    "resolution_count": 1
  },
  "capacity_contract": {
    "configured_default_threshold": 250000,
    "unknown_context_window_strategy": {
      "planning_prompt_capacity": "configured_threshold > 0 ? configured_threshold : configured_default_threshold",
      "model_context_window": "min(planning_prompt_capacity + reserved_output_tokens + autocompact_buffer_tokens, u64_max)",
      "default_model_context_window": 279000
    },
    "context_window_resolution": {
      "precedence": [
        "positive_task_metadata.model_context_window",
        "resolved_model.context_length",
        "derived_planning_context"
      ],
      "non_positive_task_metadata_is_absent": true,
      "cases": [
        {
          "name": "zero_metadata_uses_resolved_capability",
          "input": {
            "task_metadata_model_context_window": 0,
            "resolved_model_context_window": 64000
          },
          "expected_model_context_window": 64000
        },
        {
          "name": "zero_metadata_without_resolved_capability_uses_derived_planning_context",
          "input": {
            "task_metadata_model_context_window": 0,
            "resolved_model_context_window": null,
            "configured_threshold": 250000,
            "reserved_output_tokens": 16000,
            "autocompact_buffer_tokens": 13000
          },
          "expected_model_context_window": 279000
        }
      ]
    },
    "reserved_output_tokens_fallback": 16000,
    "autocompact_buffer_tokens_default": 13000,
    "microcompact_trigger_ratio_default": 0.75,
    "microcompact_target_ratio_default": 0.6,
    "microcompact_ratio_constraints": {
      "target_ratio": "0 < target_ratio < trigger_ratio",
      "trigger_ratio": "trigger_ratio <= 1"
    },
    "resolved_model_max_output_is_capability_not_request_default": true,
    "reserved_output_precedence": [
      "effective_model_settings.max_tokens",
      "task_metadata.reserved_output_tokens",
      "framework_fallback"
    ],
    "reserved_output_source_values": [
      "model_settings",
      "task_metadata",
      "framework_fallback",
      "framework_fallback_capped_by_model_capability"
    ],
    "formula": {
      "derived_prompt_capacity": "max(model_context_window - reserved_output_tokens - autocompact_buffer_tokens, 0)",
      "effective_threshold": "configured_threshold > 0 ? min(configured_threshold, derived_prompt_capacity) : derived_prompt_capacity",
      "microcompact_threshold": "floor(effective_threshold * microcompact_trigger_ratio)",
      "microcompact_target": "floor(effective_threshold * microcompact_target_ratio)",
      "known_zero_capacity_stays_zero": true
    },
    "cases": [
      {
        "name": "kimi_k3_uses_full_configured_ceiling",
        "input": {
          "configured_threshold": 250000,
          "model_context_window": 1048576,
          "effective_model_max_tokens": null,
          "task_metadata_reserved_output_tokens": null,
          "model_max_output_tokens": 1048576,
          "autocompact_buffer_tokens": 13000
        },
        "expected": {
          "reserved_output_tokens": 16000,
          "reserved_output_source": "framework_fallback",
          "effective_threshold": 250000,
          "microcompact_threshold": 187500,
          "microcompact_target": 150000
        }
      },
      {
        "name": "deepseek_v4_pro_uses_full_configured_ceiling",
        "input": {
          "configured_threshold": 250000,
          "model_context_window": 1000000,
          "effective_model_max_tokens": null,
          "task_metadata_reserved_output_tokens": null,
          "model_max_output_tokens": 384000,
          "autocompact_buffer_tokens": 13000
        },
        "expected": {
          "reserved_output_tokens": 16000,
          "reserved_output_source": "framework_fallback",
          "effective_threshold": 250000,
          "microcompact_threshold": 187500,
          "microcompact_target": 150000
        }
      },
      {
        "name": "explicit_request_limit_wins",
        "input": {
          "configured_threshold": 250000,
          "model_context_window": 256000,
          "effective_model_max_tokens": 4096,
          "task_metadata_reserved_output_tokens": 32000,
          "model_max_output_tokens": 256000,
          "autocompact_buffer_tokens": 13000
        },
        "expected": {
          "reserved_output_tokens": 4096,
          "reserved_output_source": "model_settings",
          "effective_threshold": 238904,
          "microcompact_threshold": 179178,
          "microcompact_target": 143342
        }
      },
      {
        "name": "explicit_host_reserve_wins_without_request_limit",
        "input": {
          "configured_threshold": 250000,
          "model_context_window": 256000,
          "effective_model_max_tokens": null,
          "task_metadata_reserved_output_tokens": 32768,
          "model_max_output_tokens": 256000,
          "autocompact_buffer_tokens": 13000
        },
        "expected": {
          "reserved_output_tokens": 32768,
          "reserved_output_source": "task_metadata",
          "effective_threshold": 210232,
          "microcompact_threshold": 157674,
          "microcompact_target": 126139
        }
      },
      {
        "name": "explicit_request_limit_is_not_capped_by_smaller_model_capability",
        "input": {
          "configured_threshold": 250000,
          "model_context_window": 64000,
          "effective_model_max_tokens": 24000,
          "task_metadata_reserved_output_tokens": null,
          "model_max_output_tokens": 4096,
          "autocompact_buffer_tokens": 13000
        },
        "expected": {
          "reserved_output_tokens": 24000,
          "reserved_output_source": "model_settings",
          "effective_threshold": 27000,
          "microcompact_threshold": 20250,
          "microcompact_target": 16200
        }
      },
      {
        "name": "explicit_host_reserve_is_not_capped_by_smaller_model_capability",
        "input": {
          "configured_threshold": 250000,
          "model_context_window": 64000,
          "effective_model_max_tokens": null,
          "task_metadata_reserved_output_tokens": 24000,
          "model_max_output_tokens": 4096,
          "autocompact_buffer_tokens": 13000
        },
        "expected": {
          "reserved_output_tokens": 24000,
          "reserved_output_source": "task_metadata",
          "effective_threshold": 27000,
          "microcompact_threshold": 20250,
          "microcompact_target": 16200
        }
      },
      {
        "name": "fallback_is_capped_by_smaller_model_capability",
        "input": {
          "configured_threshold": 250000,
          "model_context_window": 32000,
          "effective_model_max_tokens": null,
          "task_metadata_reserved_output_tokens": null,
          "model_max_output_tokens": 8192,
          "autocompact_buffer_tokens": 13000
        },
        "expected": {
          "reserved_output_tokens": 8192,
          "reserved_output_source": "framework_fallback_capped_by_model_capability",
          "effective_threshold": 10808,
          "microcompact_threshold": 8106,
          "microcompact_target": 6484
        }
      },
      {
        "name": "known_zero_capacity_stays_zero",
        "input": {
          "configured_threshold": 250000,
          "model_context_window": 10000,
          "effective_model_max_tokens": 10000,
          "task_metadata_reserved_output_tokens": null,
          "model_max_output_tokens": 10000,
          "autocompact_buffer_tokens": 13000
        },
        "expected": {
          "reserved_output_tokens": 10000,
          "reserved_output_source": "model_settings",
          "effective_threshold": 0,
          "microcompact_threshold": 0,
          "microcompact_target": 0
        }
      }
    ]
  },
  "compaction_events": {
    "started": {
      "trigger_values": [
        "micro_threshold",
        "full_threshold",
        "prompt_too_long"
      ],
      "producer_fields": [
        "trigger",
        "configured_threshold",
        "effective_threshold",
        "microcompact_threshold",
        "microcompact_target",
        "candidate_count",
        "estimated_reclaimable_tokens",
        "model_context_window",
        "model_max_output_tokens",
        "reserved_output_tokens",
        "reserved_output_source",
        "autocompact_buffer_tokens"
      ],
      "candidate_count_semantics": "number_of_oldest_first_candidates_selected_by_the_single_plan",
      "estimated_reclaimable_tokens_semantics": "estimated_prompt_token_reduction_if_every_selected_archive_succeeds"
    },
    "completed": {
      "mode_values": [
        "none",
        "micro",
        "structural",
        "summary",
        "emergency"
      ],
      "producer_fields": [
        "mode",
        "changed",
        "archived_count",
        "reclaimed_tokens",
        "artifact_failure_count"
      ],
      "archived_count_semantics": "selected_results_successfully_persisted_and_replaced",
      "reclaimed_tokens_semantics": "actual_prompt_token_reduction_after_successful_replacements",
      "artifact_failure_count_semantics": "selected_results_left_inline_because_archive_persistence_failed",
      "changed_is_content_aware": true,
      "mode_is_strongest_applied_stage": true
    },
    "microcompact_planning": {
      "single_plan_and_apply_pass_per_cycle": true,
      "candidate_required_for_micro_threshold_trigger": true,
      "micro_threshold_without_candidate_event_count": 0,
      "full_or_prompt_too_long_trigger_may_start_without_micro_candidate": true,
      "candidate_order": "oldest_first",
      "stop_condition": "actual_post_replacement_usage_at_or_below_microcompact_target_or_candidates_exhausted",
      "planned_estimates_do_not_satisfy_target": true,
      "reclaimed_tokens_per_candidate": "actual_original_message_tokens_minus_actual_replacement_message_tokens",
      "recalculate_actual_usage_after_each_successful_replacement": true,
      "archive_before_replace": true,
      "archive_failure_preserves_original": true,
      "existing_artifact_requires_utf8_size_and_sha256_validation": true,
      "existing_artifact_validation_failure_preserves_original": true,
      "archive_failure_does_not_stop_later_candidates": true
    },
    "simultaneous_warning_and_microcompact": {
      "order": [
        "microcompact_eligible_old_tool_results",
        "recalculate_effective_length",
        "append_memory_warning_only_if_post_microcompact_length_remains_eligible"
      ],
      "warning_uses_post_microcompact_length": true,
      "warning_must_not_prevent_eligible_microcompact": true
    },
    "provider_and_journal_share_event_identity": [
      "event_id",
      "created_at"
    ],
    "missing_or_unknown_fields_are_rejected": true,
    "unknown_enum_values_are_rejected": true,
    "task_semantics_are_not_inspected": true,
    "tool_result_format_is_not_inspected": true
  },
  "provider_attempts": {
    "prompt_too_long_failures_before_success": 2,
    "started_count": 2,
    "completed_count": 2,
    "strategies": [
      {
        "attempt": 1,
        "strategy": "forced",
        "drop_ratio": null
      },
      {
        "attempt": 2,
        "strategy": "emergency",
        "drop_ratio": 0.4
      }
    ],
    "result_metadata": {
      "phase": "before"
    },
    "before_error": {
      "stage": "before_compact",
      "error": "before exploded"
    },
    "after_error": {
      "stage": "after_compact",
      "error": "after exploded"
    }
  },
  "session_memory": {
    "enabled_by_default": false,
    "explicit_control": "session_memory_enabled",
    "accepted_aliases": [],
    "seed_implies_enabled": false,
    "existing_storage_implies_enabled": false,
    "parent_value_inherited_by_child": false,
    "gate_cases": [
      {
        "name": "explicitly_enabled",
        "control": true,
        "provided_context": "fresh decision",
        "stored_entries_present": true,
        "expected": {
          "context_sections_rendered": 1,
          "storage_reads_allowed": true,
          "storage_writes_allowed": true,
          "session_memory_model_dispatches_allowed": true
        }
      },
      {
        "name": "explicitly_disabled_ignores_all_memory_inputs",
        "control": false,
        "provided_context": "must not be rendered",
        "seed_entries_present": true,
        "stored_entries_present": true,
        "expected": {
          "context_sections_rendered": 0,
          "storage_read_count": 0,
          "storage_write_count": 0,
          "session_memory_model_dispatch_count": 0
        }
      },
      {
        "name": "omitted_control_uses_disabled_default",
        "control": "omitted",
        "provided_context": "must not be rendered",
        "seed_entries_present": true,
        "stored_entries_present": true,
        "expected": {
          "context_sections_rendered": 0,
          "storage_read_count": 0,
          "storage_write_count": 0,
          "session_memory_model_dispatch_count": 0
        }
      },
      {
        "name": "child_does_not_inherit_enabled_parent",
        "parent_control": true,
        "child_control": "omitted",
        "expected": {
          "child_effective_control": false,
          "child_context_sections_rendered": 0,
          "child_storage_read_count": 0,
          "child_storage_write_count": 0,
          "child_session_memory_model_dispatch_count": 0
        }
      }
    ],
    "stale_fact": "stale decision",
    "fresh_fact": "fresh decision",
    "block_count": 1,
    "initialized_after_compaction": true,
    "baseline_includes_injected_context": true,
    "invalid_output_diagnostic": {
      "type": "diagnostic",
      "level": "warning",
      "code": "session_memory_output_invalid",
      "details_required": [
        "reason",
        "backend",
        "model"
      ],
      "reason_values": [
        "empty_output",
        "json_array_missing",
        "no_valid_entries"
      ],
      "forbidden_details": [
        "prompt",
        "output",
        "messages",
        "error_text"
      ]
    },
    "checkpoint_receipt_replay": {
      "new_model_dispatches": 0,
      "new_model_call_records": 0,
      "new_budget_increment": 0,
      "derived_mutation_is_reapplied": true,
      "entry_merge_uses_canonical_category_and_content_key": true,
      "extraction_baseline_advances_after_merge": true,
      "replay_is_idempotent": true
    },
    "control_outcomes_propagate": [
      "cancellation",
      "budget_exhaustion",
      "checkpoint_ambiguity",
      "checkpoint_integrity_failure"
    ]
  },
  "artifacts": {
    "logical_root": ".vv-agent/artifacts/",
    "written_through_effective_workspace_backend": true,
    "immutable": true,
    "microcompact_requires_success": true,
    "model_visible_marker_fields": [
      "tool_name",
      "artifact_path",
      "retrieval_hint",
      "excerpt"
    ],
    "model_visible_marker_forbidden_fields": [
      "original_bytes",
      "visible_bytes",
      "size_bytes",
      "sha256",
      "total_chars",
      "truncated_chars"
    ]
  }
}

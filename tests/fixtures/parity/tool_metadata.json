      "unknown",
      "supported",
      "unsupported"
    ],
    "missing_metadata_result_retention": "archive",
    "model_visible": false,
    "optional": true,
    "result_retention_is_not_inferred": true,
    "result_retention_semantics": "archive makes old results eligible for artifact-backed proactive microcompaction; preserve excludes them only from proactive microcompaction",
    "result_retention_values": [
      "archive",
      "preserve"
    ],
    "side_effect_semantics": "one coarse host declaration; the SDK does not infer additional effects, ordering, or hierarchy between values",
    "side_effect_values": [
      "unknown",
      "none",
      "read",
      "write",
      "execute",
      "network",
      "external"
    ],
    "terminal_semantics": "declares that the tool may return finish or wait_user; it never makes the framework stop automatically"
  },

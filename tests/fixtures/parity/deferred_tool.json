{
  "contract": "durable_deferred_tool",
  "schema_version": "vv-agent.durable-deferred-tool.v2",
  "contract_version": "12.0.0",
  "scope": "framework_host_boundary_only",
  "versioning": {
    "forward_only": true,
    "replaces": "the previous deferred-tool wire is not accepted by the current reader",
    "old_reader": "reject",
    "support_matrix": "pending-adoption"
  },
  "status_domains": {
    "agent_status": [
      "pending",
      "running",
      "host_interaction",
      "suspended",
      "deferred",
      "reconciliation_required",
      "wait_user",
      "completed",
      "failed",
      "max_cycles"
    ],
    "tool_result_status": [
      "SUCCESS",
      "ERROR",
      "WAIT_RESPONSE",
      "RUNNING",
      "PENDING_COMPRESS"
    ],
    "deferred_is_distinct_from": [
      "running",
      "host_interaction",
      "suspended",
      "wait_response",
      "reconciliation_required",
      "ToolExecutionResult"
    ],
    "completed_never_accepts_deferred": true
  },
  "handle": {
    "schema_version": "vv-agent.deferred-tool-handle.v2",
    "discriminator": {
      "field": "schema_version",
      "required_value": "vv-agent.deferred-tool-handle.v2",
      "missing_stale_unknown_error": "deferred_handle_schema_unsupported"
    },
    "required_fields": [
      "schema_version",
      "checkpoint_key",
      "operation_id",
      "attempt",
      "request_digest"
    ],
    "identity_fields": [
      "checkpoint_key",
      "operation_id",
      "attempt",
      "request_digest"
    ],
    "wire_description": "four identity fields plus required schema discriminator",
    "unknown_fields": "reject",
    "fields": {
      "checkpoint_key": "non_empty_checkpoint_key_string",
      "operation_id": "non_empty_stable_operation_id_string",
      "attempt": "positive_json_safe_integer",
      "request_digest": "lowercase_sha256_of_vv-agent.operation-request.v1"
    },
    "framework_identity_only": true,
    "forbidden_fields": [
      "provider_id",
      "job_id",
      "poll",
      "callback",
      "manual_action",
      "deadline",
      "cancel",
      "celery",
      "mcp",
      "permission",
      "billing",
      "business_id",
      "proof",
      "authority"
    ],
    "all_canonical_examples_include_discriminator": true,

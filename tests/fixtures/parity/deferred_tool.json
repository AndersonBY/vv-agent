  "tool_context": {
    "factory": "ToolContext.defer",
    "public_signature": "defer(self) -> ToolCallOutcome.Deferred",
    "framework_constructs": [
      "schema_version",
      "checkpoint_key",
      "operation_id",
      "attempt",
      "request_digest"
    ],
    "executor_must_not_construct": [
      "DeferredToolHandle",
      "checkpoint revision",
      "journal entry",
      "event outbox record",
      "claim token"
    ],
    "factory_boundary": "create the handle and deferred outcome before external acceptance; the handler may pass the opaque handle to its provider outside the core contract",
    "checkpoint_requirement": {
      "without_checkpoint": {
        "failure": "deferred_requires_checkpoint",
        "failure_phase": "before_external_side_effect_or_acceptance",
        "effect": "none",
        "outcome": "Completed(ERROR)",
        "result": {
          "tool_call_id": "call_without_checkpoint",
          "content": "Deferred execution requires a durable checkpoint.",
          "status_code": "ERROR",
          "directive": "continue",
          "error_code": "deferred_requires_checkpoint"
        }
      },
      "local_durable_checkpoint": {
        "allowed": true,
        "stores": [
          "in_memory",
          "sqlite",
          "redis"
        ],
        "same_admission_and_resolution_cas": true,
        "in_memory_lifetime": "durable for the active process only",
        "cross_process_callback_requires": [
          "sqlite",
          "redis"
        ]
      },
      "non_durable_run": {
        "allowed": false,
        "must_not_synthesize_handle": true,
        "factory_returns_error_before_provider_call": true
      }
    }
  },
  "outcome": {
    "schema_version": "vv-agent.tool-call-outcome.v2",
    "discriminator": "kind",
    "variants": {
      "completed": {
        "required_fields": [
          "kind",
          "result"
        ],
        "kind": "completed",
        "result": "complete ToolExecutionResult",
        "result_status_must_not_be": [
          "deferred"
        ]
      },
      "deferred": {
        "required_fields": [
          "kind",
          "handle"
        ],
        "kind": "deferred",
        "handle_type": "DeferredToolHandle",
        "model_visible_tool_result": false
      }
    },
    "closed_objects": true,
    "exactly_one_variant": true,
    "completed_result_is_not_deferred_status": true
  },
  "tool_result_status_contract": {
    "wire_schema_version": "vv-agent.tool-execution-result.v4",
    "field": "status_code",
    "allowed_values": [
      "SUCCESS",
      "ERROR",
      "WAIT_RESPONSE",
      "RUNNING",
      "PENDING_COMPRESS"
    ],
    "deferred_representation": "ToolCallOutcome.Deferred(handle)",
    "duplicate_status_removed": "the former deferred member is not a ToolExecutionResult status",
    "definitive_resolution_statuses": [
      "SUCCESS",
      "ERROR"
    ],
    "non_definitive_resolution_statuses": [
      "WAIT_RESPONSE",
      "RUNNING",
      "PENDING_COMPRESS"
    ]
  },
  "journal": {
    "schema_version": "vv-agent.operation-journal.v5",
    "states": [
      "planned",
      "started",
      "deferred",
      "succeeded",
      "failed",
      "ambiguous"
    ],
    "deferred_entry_fields": [
      "kind",
      "operation_id",
      "cycle_index",
      "attempt",
      "request_digest",
      "tool_call_id",
      "tool_name",
      "idempotency_key",
      "idempotency_support",
      "state",
      "deferred_handle",
      "result",
      "error"
    ],
    "deferred_entry_rules": {
      "state": "deferred",
      "deferred_handle_required": true,
      "result_must_be_null": true,
      "error_must_be_null": true,
      "handle_identity_must_match_entry": [
        "checkpoint_key",
        "operation_id",
        "attempt",
        "request_digest"
      ],
      "checkpoint_key_must_match_store_key": true
    },
    "resolved_entry_rules": {
      "succeeded": {
        "state": "succeeded",
        "result_required": true,
        "result_status": "SUCCESS",
        "result_digest_required": true,
        "result_digest_covers": "complete canonical ToolExecutionResult",
        "error_must_be_null": true
      },
      "failed": {
        "state": "failed",
        "result_required": true,
        "result_status": "ERROR",
        "result_digest_required": true,
        "result_digest_covers": "complete canonical ToolExecutionResult",
        "error_required": true,
        "error_is_typed": true,
        "error_is_projection_only": true,
        "error_projection_source": "result",
        "resume_source": "result, never error"
      }
    },
    "resolution_transitions": [
      [
        "deferred",
        "succeeded"
      ],
      [
        "deferred",
        "failed"
      ]
    ],
    "admission_transitions": [
      [
        "started",
        "deferred"
      ],
      [
        "ambiguous",
        "deferred"
      ]
    ],
    "admission_transition_operations": {
      "started_to_deferred": "admit_deferred_batch",
      "ambiguous_to_deferred": "accept_deferred_batch"
    },
    "deferred_is_not": [
      "started",
      "ambiguous",
      "succeeded",
      "failed"
    ]
  },
  "batch": {
    "model_tool_batch_is_collected_while_claim_is_held": true,
    "admission_operation": "admit_deferred_batch",
    "ordinary_receipt_operation": "record_tool_receipt",
    "ordinary_receipts_are_written_before_admission": true,
    "caller_loops_single_item_admission": false,
    "outcome_order": "original_model_tool_call_order",
    "mixed_completed_and_deferred": {
      "completed_outcomes": "already persisted by record_tool_receipt while the active claim is retained",
      "completed_status_mapping": {
        "SUCCESS": {
          "journal_state": "succeeded",
          "event_status": "success"
        },
        "ERROR": {
          "journal_state": "failed",
          "event_status": "error",
          "error_required": true,
          "result_required": true,
          "result_digest_required": true
        }
      },
      "deferred_outcomes": "persist only deferred journal handles and tool_call_deferred events in this same batch CAS",
      "checkpoint_status": "deferred when at least one deferred outcome exists",
      "claim_release": "one release after the complete batch CAS, never once per item",
      "all_or_none": true,
      "all_or_none_scope": "deferred_admission_only; ordinary receipts are committed by record_tool_receipt before this CAS",
      "completed_outcome_admission": "deferred_admission_completed_outcome_invalid",
      "already_receipted_admission": "reject_deferred_admission_receipt_already_recorded",
      "ordinary_receipt_is_not_repeated": true,
      "pre_cas_crash": "every started entry not covered by the CAS is ambiguous; no completed or deferred outcome is inferred"
    },
    "admission_cas": {
      "compare_and_swap": [
        "checkpoint_key",
        "expected_checkpoint_revision",
        "active_claim_token",
        "active_claimed_cycle"
      ],
      "input": "ordered deferred-only outcomes for the still-unresolved model tool calls",
      "writes": [
        "all deferred journal handles",
        "all tool_call_deferred events",
        "checkpoint status/barrier",
        "claim and lease release"
      ],
      "revision_increment": 1,
      "external_tools_called": 0,
      "rejects": [
        "completed outcome",
        "already receipted definitive outcome",
        "duplicate deferred handle"
      ],
      "atomic": true
    },
    "outbox_preflight": {
      "bounded": true,
      "bound_kind": "lifecycle_bounded",
      "fixed_cardinality_or_bytes_cap": false,
      "batch_size_known_before_external_effect": true,
      "before_first_external_tool_effect": true,
      "reserve_for": [
        "started event for every model-tool call in the batch",
        "completed SUCCESS or ERROR event for every completed outcome",
        "tool_call_deferred event for every deferred outcome",
        "tool_call_completed event for every later resolution"
      ],
      "ordinary_and_deferred_tools": true,
      "admission_capacity_rejection": false,
      "resolution_capacity_rejection": false,
      "post_effect_outbox_full": "forbidden",
      "negative_cases": [
        "outbox_full_after_started_effect",
        "deferred_resolution_capacity_rejected_after_provider_effect"
      ]
    },

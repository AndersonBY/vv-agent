{
  "contract": "checkpoint_store",
  "version": 7,
  "checkpoint_schema": "vv-agent.checkpoint.v7",
  "run_definition_schema": "vv-agent.run-definition.v5",
  "deferred_contract": "deferred_tool.json",
  "deferred_receipt_index": {
    "independent": true,
    "key": "sha256_rfc8785_canonical_exact_deferred_handle",
    "required": true,
    "bounded": false,
    "lifecycle_bounded": true,
    "bound_kind": "checkpoint_and_retained_terminal_lifecycle",
    "fixed_cardinality_or_bytes_cap": false,
    "arbitrary_cardinality": true,
    "retained_with_checkpoint_and_terminal": true,
    "deleted_with_explicit_checkpoint_cleanup": true,
    "entry_shape_source": "deferred_tool.json#resolution.receipt_index.tombstone_entry",
    "sqlite_table": "deferred_resolution_receipts",
    "redis_key_prefix": "vv-agent:deferred-receipt:"
  },
  "run_definition_storage": "credential_redacted_object_embedded_and_immutable_beside_matching_digest",
  "namespaces": {
    "sqlite_table": "checkpoints",
    "redis_key_prefix": "vv-agent:checkpoint:",
    "redis_key_suffix": "lowercase_sha256_of_checkpoint_key",
    "deferred_receipt_sqlite_table": "deferred_resolution_receipts",
    "deferred_receipt_redis_key_prefix": "vv-agent:deferred-receipt:",
    "deferred_receipt_redis_key_suffix": "lowercase_sha256_of_rfc8785_exact_handle",
    "deferred_receipt_checkpoint_set_prefix": "vv-agent:deferred-receipts-by-checkpoint:"
  },
  "redis_key_vectors": [
    {
      "checkpoint_key": "tenant-7/run-42",

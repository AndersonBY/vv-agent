      "data_key": "vv-agent:checkpoint:900c4d195b6e2d16f4ac0725d2306d5b9685397249d4581e107769f38cb068c7",
      "lease_key": "vv-agent:checkpoint:900c4d195b6e2d16f4ac0725d2306d5b9685397249d4581e107769f38cb068c7:lease"
    },
    {
      "checkpoint_key": "研究/运行-42",
      "checkpoint_key_utf8_sha256": "e6b1a2e6f36de6d5273e0ea9b2617ed36e49d0663668dd4cd30ea1091b0d974c",
      "data_key": "vv-agent:checkpoint:e6b1a2e6f36de6d5273e0ea9b2617ed36e49d0663668dd4cd30ea1091b0d974c",
      "lease_key": "vv-agent:checkpoint:e6b1a2e6f36de6d5273e0ea9b2617ed36e49d0663668dd4cd30ea1091b0d974c:lease"
    }
  ],
  "deferred_receipt_key_vectors": [
    {
      "handle_key": "5be3ae2193b49698a007a5a0d332ea5481f38475ac97ec36efc0e017e5aee82a",
      "data_key": "vv-agent:deferred-receipt:5be3ae2193b49698a007a5a0d332ea5481f38475ac97ec36efc0e017e5aee82a",
      "checkpoint_set_key": "vv-agent:deferred-receipts-by-checkpoint:900c4d195b6e2d16f4ac0725d2306d5b9685397249d4581e107769f38cb068c7"
    }
  ],
  "operations": [
    {
      "name": "create",
      "atomic": "insert_if_absent"
    },
    {
      "name": "load",
      "atomic": "read_one"
    },
    {
      "name": "claim",
      "atomic": "compare_status_cycle_and_lease_then_claim_and_increment_resume_attempt_only_for_recovery_mode"
    },
    {
      "name": "renew",
      "atomic": "compare_claim_token_and_live_lease_then_update_lease_only"
    },
    {
      "name": "progress",
      "atomic": "compare_revision_and_claim_token_then_update_payload_and_revision_preserving_claim"
    },
    {
      "name": "admit_deferred_batch",
      "atomic": "compare revision claim and complete ordered batch outcomes then persist all journals events barrier and release claim once"
    },
    {
      "name": "accept_deferred_batch",
      "atomic": "CAS expected_revision plus active recovery claim token/cycle and exact current-batch decisions; persist every accepted journal entry, reconciliation audit, tool_call_deferred outbox event, barrier/status, and one claim release or write nothing"
    },
    {
      "name": "resolve_deferred",
      "atomic": "receipt-index-first internal revision CAS loop atomically persists journal index tombstone event barrier status and revision without claim"
    },
    {
      "name": "suspend",
      "atomic": "compare_revision_and_claim_token_then_persist_resumable_interruption_preserve_journals_and_clear_claim"
    },
    {
      "name": "commit_cycle",
      "atomic": "compare_revision_and_claim_token_then_commit_cycle_clear_journals_and_claim"
    },
    {
      "name": "finalize_claimed",
      "atomic": "compare_revision_and_claim_token_then_write_terminal_clear_claim_and_clear_ordinary_journals"
    },
    {
      "name": "finalize",
      "atomic": "compare_revision_and_no_claim_then_write_terminal_preserving_explicit_operator_abort_ambiguity"
    },
    {
      "name": "record_event_delivery",
      "atomic": "compare_revision_claim_and_pending_event_identity_then_record_cursor_preserving_claim_or_terminal"
    },
    {
      "name": "acknowledge_terminal",
      "atomic": "compare_revision_and_terminal_then_mark_acknowledged_without_delete"
    },
    {
      "name": "delete",
      "atomic": "explicit_host_retention_cleanup_deletes_checkpoint_and_all_handle_receipt_index_rows_together"
    }
  ],
  "revision_rules": {
    "create": 0,
    "claim_increment": 1,
    "progress_increment": 1,
    "suspend_increment": 1,
    "cycle_commit_increment": 1,
    "claimed_finalize_increment": 1,
    "finalize_increment": 1,
    "event_delivery_increment": 1,
    "renew_increment": 0,
    "acknowledge_increment": 1,
    "heartbeat_requires_revision": false,
    "heartbeat_requires_claim_token": true,
    "progress_preserves_claim": true,
    "admit_deferred_batch_releases_claim_atomically": true,
    "admit_deferred_batch_requires_started_journal": true,
    "resolve_deferred_requires_exact_handle": true,
    "resolve_deferred_requires_definitive_result": true,
    "resolve_deferred_same_replay_is_idempotent": true,
    "resolve_deferred_early_started_is_retryable_not_admitted": true,
    "resolve_deferred_early_started_writes_nothing": true,
    "resolve_deferred_ambiguous_uses_reconciliation": true,
    "resolve_deferred_conflict_error": "deferred_resolution_conflict",
    "resolve_deferred_stale_error": "deferred_resolution_stale",
    "resolve_deferred_claimed_error": "deferred_checkpoint_claimed",
    "resolve_deferred_not_admitted_error": "deferred_resolution_not_admitted",
    "resolve_deferred_does_not_claim_or_invoke_tool": true,
    "deferred_batch_barrier_blocks_cycle_commit_and_model_call": true,
    "claim_modes": [
      "continue",
      "recovery"
    ],
    "continue_claim_preserves_resume_attempt": true,
    "successful_recovery_claim_increments_resume_attempt": true,
    "failed_recovery_claim_preserves_resume_attempt": true,
    "claimable_statuses": [
      "running",
      "reconciliation_required"
    ],
    "successful_claim_sets_status_running": true,
    "suspend_preserves_active_journals": true,
    "suspend_clears_claim_without_advancing_cycle": true,
    "claimed_finalize_clears_claim_atomically": true,
    "event_delivery_preserves_claim_and_terminal": true,
    "outbox_event_ids_unique": true,
    "outbox_bounded_by_lifecycle_not_fixed_cardinality_or_bytes": true,
    "outbox_preflight_before_first_external_tool_effect": true,
    "outbox_no_post_effect_capacity_failure": true,
    "identical_event_enqueue_reuses_existing_entry": true,
    "conflicting_event_enqueue_error": "event_identity_conflict",
    "terminal_model_progress_atomically_updates_journal_ledger_budget_and_outbox": true,
    "terminal_model_outbox_order": [
      "model_terminal_event",
      "budget_snapshot_or_budget_exhausted_if_configured"
    ],
    "model_call_ids_are_unique": true,
    "receipt_replay_does_not_append_model_call_or_budget": true,
    "cycle_commit_preserves_model_call_ledger": true,
    "run_definition_and_digest_immutable_after_create": true,
    "operator_abort_finalize_preserves_ambiguous_journal": true,
    "admit_deferred_batch_all_or_none": true,
    "admit_deferred_batch_one_revision_increment": true,
    "admit_deferred_batch_one_claim_release": true,
    "mixed_completed_and_deferred_batch_is_atomic": true,
    "deferred_receipt_index_independent_from_checkpoint": true,
    "deferred_receipt_index_unbounded_by_contract": true,
    "deferred_receipt_index_retained_after_terminal": true,
    "deferred_receipt_index_cleanup_shares_checkpoint_lifetime": true,
    "deferred_receipt_index_write_is_same_transaction_as_resolution": true,
    "resolve_deferred_internal_revision_retry": true,
    "resolve_deferred_caller_does_not_pass_expected_revision": true,
    "resolve_deferred_success_transition": [
      "deferred",
      "succeeded"
    ],
    "resolve_deferred_failed_transition": [
      "deferred",
      "failed"
    ],
    "deferred_status_not_claimable": true,
    "claim_rejects_deferred_before_claim_token": true,
    "accept_deferred_batch_requires_recovery_claim": true,
    "accept_deferred_batch_all_or_none": true,
    "accept_deferred_batch_one_revision_increment": true,
    "accept_deferred_batch_one_claim_release": true
  },

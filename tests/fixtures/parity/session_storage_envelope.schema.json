{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "vv-agent.session-storage-envelope-cases.v1"
    },
    "status": {
      "const": "contract-allocation-only"
    },
    "framing": {
      "$ref": "#/$defs/Framing"
    },
    "cases": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "logical_record": {
                "type": "object"
              },
              "logical_record_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "maxLength": 64
              },
              "previous_chain_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "maxLength": 64
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accepted": {
                "const": true,
                "type": "boolean"
              },
              "envelope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "const": "S1",
                    "type": "string"
                  },
                  "tenant_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "session_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "seq": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "record_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "maxLength": 64
                  },
                  "chain_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "maxLength": 64
                  },
                  "writer_epoch": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "created_ms": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "schema_version",
                  "tenant_id",
                  "session_id",
                  "seq",
                  "record_digest",
                  "chain_digest",
                  "writer_epoch",
                  "created_ms"
                ]
              }
            },
            "required": [
              "name",
              "logical_record",
              "logical_record_digest",
              "previous_chain_digest",
              "reason",
              "accepted",
              "envelope"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "logical_record": {
                "type": "object"
              },
              "logical_record_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "maxLength": 64
              },
              "previous_chain_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "maxLength": 64
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "const": false,
                "type": "boolean"
              },
              "envelope": {
                "type": "object"
              }
            },
            "required": [
              "name",
              "logical_record",
              "logical_record_digest",
              "previous_chain_digest",
              "reason",
              "accepted",
              "envelope"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "framing",
    "cases"
  ],
  "$defs": {
    "Framing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "const": "vv-agent/S1"
        },
        "initial_formula": {
          "const": "SHA256(UTF8(domain)||LP(tenant_id)||LP(session_id))"
        },
        "next_formula": {
          "const": "SHA256(previous_chain||U64BE(seq)||HEX_DECODE(record_digest))"
        },
        "identifier_encoding": {
          "const": "UTF-8 with unsigned 32-bit big-endian byte length prefix"
        },
        "identity_rule": {
          "const": "chain_digest is excluded from logical record bytes and record identity"
        }
      },
      "required": [
        "domain",
        "initial_formula",
        "next_formula",
        "identifier_encoding",
        "identity_rule"
      ]
    },
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "S1",
          "type": "string"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "record_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "chain_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "writer_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "created_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "session_id",
        "seq",
        "record_digest",
        "chain_digest",
        "writer_epoch",
        "created_ms"
      ]
    }
  }
}
